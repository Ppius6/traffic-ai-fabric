  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "6d0f7d51-1153-4adb-9882-a995661a5c1d"
      },
      "text": "EnhancedTrafficEvents\r\n| where Timestamp > ago(15m)\r\n| summarize \r\n    EventCount = count(),\r\n    AvgDensity = round(avg(TrafficDensity), 1),\r\n    AvgRiskScore = round(avg(RiskScore), 3),\r\n    HighRiskCount = countif(RiskLevel == \"High\"),\r\n    LatestAlert = max(Timestamp)\r\n    by LocationName, RoadName, Latitude, Longitude\r\n| extend \r\n    RiskLevel = case(\r\n        AvgRiskScore >= 0.7, \"High\",\r\n        AvgRiskScore >= 0.5, \"Medium\",\r\n        \"Low\"\r\n    ),\r\n    RiskColor = case(\r\n        AvgRiskScore >= 0.7, \"red\",\r\n        AvgRiskScore >= 0.5, \"orange\",\r\n        \"green\"\r\n    ),\r\n    Size = case(\r\n        EventCount >= 10, \"large\",\r\n        EventCount >= 5, \"medium\", \r\n        \"small\"\r\n    )\r\n| project \r\n    Longitude, \r\n    Latitude, \r\n    Title = strcat(LocationName, \" - \", RoadName),\r\n    Description = strcat(\r\n        \"Density: \", tostring(AvgDensity), \"%, \",\r\n        \"Risk: \", tostring(AvgRiskScore), \", \",\r\n        \"Events: \", tostring(EventCount)\r\n    ),\r\n    RiskColor,\r\n    Size",
      "id": "963755c2-fa2a-4978-add5-aedf748b253e",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "6d0f7d51-1153-4adb-9882-a995661a5c1d"
      },
      "text": "EnhancedTrafficEvents\n   | where Timestamp > ago(5m)\n   | where TrafficDensity >= 80\n   | summarize HighRiskCount = count()",
      "id": "d6079c87-cd79-44e9-853f-5afa509f5bca",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "6d0f7d51-1153-4adb-9882-a995661a5c1d"
      },
      "text": "EnhancedTrafficEvents\n| where Timestamp > ago(1h)                               \n| summarize \n    AvgDensity = round(avg(TrafficDensity), 1),           \n    AvgRiskScore = round(avg(RiskScore), 3),          \n    HighRiskRate = round(countif(RiskLevel == \"High\") * 100.0 / count(), 1), \n    AlertCount = countif(AlertTriggered)                \n    by bin(Timestamp, 5m), RoadName                       \n| order by Timestamp asc\n| render timechart with (title=\"Traffic Density & Risk Trends\") ",
      "id": "bfaa6bd9-fcf9-4ba7-ae6a-dd7950ad2b61",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "6d0f7d51-1153-4adb-9882-a995661a5c1d"
      },
      "text": "EnhancedTrafficEvents\n| where Timestamp > ago(10m)\n| order by Timestamp desc\n| project \n    Time = format_datetime(Timestamp, 'HH:mm:ss'),\n    Location = strcat(LocationName, \" (\", RoadName, \")\"),  \n    Density = TrafficDensity,\n    Weather,\n    RiskLevel = RiskLevel,                                 \n    RiskScore = round(RiskScore, 2),                       \n    Confidence = round(Confidence, 2),                    \n    Alert = iff(AlertTriggered, \"🚨\", \"\"),                 \n    RiskDisplay = case(                                   \n        RiskLevel == \"High\", \"HIGH\",\n        RiskLevel == \"Medium\", \"MEDIUM\", \n        \"LOW\"\n    )\n| take 20                                                ",
      "id": "b19f6d0d-5782-4cc7-aec8-05baa9f6210d",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "6d0f7d51-1153-4adb-9882-a995661a5c1d"
      },
      "text": "EnhancedTrafficEvents\n| where Timestamp > ago(2h)                             \n| summarize \n    EventCount = count(),\n    AvgDensity = round(avg(TrafficDensity), 1),         \n    AvgRiskScore = round(avg(RiskScore), 3),       \n    HighRiskPercentage = round(countif(RiskLevel == \"High\") * 100.0 / count(), 1),\n    AlertRate = round(countif(AlertTriggered) * 100.0 / count(), 1) \n    by Weather\n| order by AvgRiskScore desc                          ",
      "id": "48587827-7481-4d33-9082-a436877d6f84",
      "usedVariables": []
